#!/usr/bin/env node
/**
 * Manage a local dsh-superagent service (one DSH profile, default `superagent`) without affecting other sessions.
 *
 * `status`, `start`, and `restart` exit 0 while the service runs normally; 1 when it is stopped, duplicated,
 * unreachable, or reporting a runtime error, which `restart` may fix; 2 when it runs while a component such as a
 * Source reports an error; and 3 when it runs and waits for setup. A restart fixes neither 2 nor 3: they need a person.
 *
 * Usage is the same on every platform: `scripts/dsh-superagent <action>` on POSIX with its shebang, or
 * `node scripts/dsh-superagent <action>` on Windows. POSIX starts the service in a tmux session and stops it with
 * SIGINT; Windows starts a hidden process and stops it with taskkill, as platform-win32.mjs documents.
 */
import { realpathSync } from 'node:fs'
import { dirname } from 'node:path'
import { fileURLToPath } from 'node:url'
import { createPlatformDeps } from './service/platform.mjs'
import { runCli } from './service/service.mjs'

const checkout = dirname(dirname(realpathSync(fileURLToPath(import.meta.url))))

// Keep the control files and logs owner-only on POSIX, as the original script's umask(0o077) did. Windows has no
// umask; its files inherit the ACL of the checkout, so the checkout must already exclude other users.
if (process.platform !== 'win32') {
  try {
    process.umask(0o077)
  } catch {
    // A platform without a umask keeps its default.
  }
}

process.exitCode = await runCli(process.argv.slice(2), process.env,
  createPlatformDeps({ root: checkout, platform: process.platform, env: process.env }))
